---
/**
 * Project page (one per project, 7 in total). Everything restates the CV.
 * The title morphs from the home-page list via a View Transition
 * (view-transition-name t-<slug>); reduced motion turns transitions off.
 */
import Base from '../../layouts/Base.astro';
import Num from '../../components/Num.astro';
import { projects, categories, site, type Project } from '../../data/content';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project: p, next } = Astro.props;
const d = p.detail;
const sections = [
  { key: 'built', title: d.builtTitle ?? 'What I built', text: d.built },
  { key: 'measured', title: d.measuredTitle ?? 'What I measured', text: d.measured },
].filter((s) => s.text);
const isNumber = (v: string) => /^\d/.test(v);
---

<Base title={`${p.title} — ${site.name}`} description={`${p.summary} ${p.role}.`} home={false}>
  <article class="wrap page" data-cat={p.category} aria-labelledby="title">
    <p class="back">
      <a class="link" href="/#projects">← All projects</a>
    </p>

    <header class="head">
      <p class="meta-line">
        <span class="cat"><span class="cat-dot" aria-hidden="true"></span>{categories[p.category].label}</span>
        <span>{p.grades}</span>
        <span>{p.time}</span>
      </p>
      <h1 id="title" style={`view-transition-name:t-${p.slug}`}>{p.title}</h1>
      <p class="summary">{p.summary}</p>
      <dl class="kv">
        <div><dt>Role</dt><dd>{p.role}</dd></div>
        {
          p.audience && (
            <div>
              <dt>For</dt>
              <dd>{p.audience}</dd>
            </div>
          )
        }
      </dl>
    </header>

    <ul class="facts" aria-label="Key facts" data-reveal>
      {
        p.facts.map((f) => (
          <li class:list={['fact', { 'fact--text': !isNumber(f.value) }]}>
            <span class="fact-v">{isNumber(f.value) ? <Num value={f.value} /> : f.value}</span>
            <span class="fact-l">{f.label}</span>
          </li>
        ))
      }
    </ul>

    {
      sections.map((s) => (
        <section class="block" aria-labelledby={`s-${s.key}`} data-reveal>
          <h2 id={`s-${s.key}`}>{s.title}</h2>
          <p class="prose">{s.text}</p>
        </section>
      ))
    }

    {
      p.recognition && p.recognition.length > 0 && (
        <section class="block" aria-labelledby="s-recognition" data-reveal>
          <h2 id="s-recognition">Recognition</h2>
          <ul class="prose plain">
            {p.recognition.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      p.links.length > 0 && (
        <section class="block" aria-labelledby="s-links" data-reveal>
          <h2 id="s-links">Links</h2>
          <ul class="links">
            {p.links.map((l) => (
              <li>
                <a class="button ext" href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.kind === 'website' ? `Website · ${l.label}` : l.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="pager" aria-label="Projects">
      <a class="link" href="/#projects">← All projects</a>
      <a class="next" href={`/projects/${next.slug}`} data-cat={next.category}>
        <span class="next-label">Next project</span>
        <span class="next-title">
          <span class="cat-dot" aria-hidden="true"></span>{next.title}
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .page {
    --cat: var(--cat-learning);
    --button-accent: var(--cat);
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
  .page[data-cat='health'] {
    --cat: var(--cat-health);
  }
  .page[data-cat='community'] {
    --cat: var(--cat-community);
  }
  .back {
    margin-bottom: var(--space-7);
    font-size: var(--step--1);
  }

  .head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }
  .meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--cat);
  }
  .cat-dot {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--cat);
  }
  h1 {
    font-size: var(--step-6);
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-weight: 360;
    font-variation-settings: 'opsz' 144;
  }
  .summary {
    max-width: 30ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.2;
    font-weight: 360;
  }
  .kv {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
    margin-top: var(--space-2);
  }
  .kv div {
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-6);
  }
  .fact {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 2px solid var(--cat);
  }
  .fact-v {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 340;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .fact--text .fact-v {
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: 0;
  }
  .fact-l {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .block {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .block h2 {
    font-size: var(--step-2);
    font-weight: 380;
  }
  .prose {
    max-width: 64ch;
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .plain li + li {
    margin-top: var(--space-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-strong);
    font-size: var(--step--1);
  }
  .next {
    --cat: var(--cat-learning);
    display: grid;
    justify-items: end;
    gap: var(--space-1);
    text-align: right;
  }
  .next[data-cat='health'] {
    --cat: var(--cat-health);
  }
  .next[data-cat='community'] {
    --cat: var(--cat-community);
  }
  .next-label {
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .next-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
  }
  .next-title > span:last-child {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover .next-title > span:last-child {
      transform: translateX(4px);
    }
  }

  @media (min-width: 64rem) {
    .page {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
    .page > * {
      grid-column: 1 / -1;
    }
    .kv {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
    .block {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
    .block h2 {
      grid-column: 1 / span 4;
      font-size: var(--step-1);
      padding-top: 0.2em;
    }
    .block > :not(h2) {
      grid-column: 5 / -1;
    }
  }
</style>
