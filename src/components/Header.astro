---
import { nav, site, projects } from '../data/content';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const prefix = home ? '' : '/';
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a href={home ? '#top' : '/'} class="brand">{site.name}</a>

    <nav aria-label="Main" class="nav-desktop">
      <ul>
        {
          nav.map((item) =>
            item.href === '#projects' ? (
              <li class="has-index" data-index-root>
                <a href={`${prefix}${item.href}`} data-nav="projects">
                  {item.label}
                </a>
                <button
                  type="button"
                  class="index-btn"
                  aria-expanded="false"
                  aria-controls="project-index"
                  data-index-btn
                >
                  <span class="sr-only">Project index</span>
                  <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div id="project-index" class="index" hidden data-index>
                  <ol>
                    {projects.map((p) => (
                      <li>
                        <a href={`${prefix}#${p.slug}`} data-cat={p.category} data-index-link>
                          <span class="cat-dot" aria-hidden="true" />
                          {p.title}
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              </li>
            ) : (
              <li>
                <a href={`${prefix}${item.href}`} data-nav={item.href.slice(1)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <span class="nav-dot" aria-hidden="true" data-nav-dot></span>
    </nav>

    <div class="tools">
      <button type="button" class="tool menu-btn" data-menu-open aria-haspopup="dialog" aria-controls="menu">
        Menu
      </button>
    </div>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menu" data-menu>
  <div class="wrap menu-bar">
    <span class="brand" aria-hidden="true">{site.name}</span>
    <button type="button" class="tool" data-menu-close>Close</button>
  </div>
  <nav aria-label="Main (mobile)" class="wrap">
    <ol class="menu-list">
      {
        nav.map((item) => (
          <li>
            <a href={`${prefix}${item.href}`} data-menu-link>
              {item.label}
            </a>
            {item.href === '#projects' && (
              <ol class="menu-projects" aria-label="Projects">
                {projects.map((p) => (
                  <li>
                    <a href={`${prefix}#${p.slug}`} data-cat={p.category} data-menu-link>
                      <span class="cat-dot" aria-hidden="true" />
                      {p.title}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))
      }
    </ol>
  </nav>
  <p class="wrap menu-foot meta">
    <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</dialog>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // Hairline under the header once the page has scrolled.
  const onScroll = () => header.classList.toggle('is-scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu: native <dialog> gives focus trapping and Esc to close.
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  openBtn.addEventListener('click', () => {
    menu.showModal();
    root.classList.add('menu-open');
  });
  menu.addEventListener('close', () => {
    root.classList.remove('menu-open');
    openBtn.focus();
  });
  menu.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => menu.close()));

  // Mark the section currently in view. Every top-level section is watched,
  // so sections without a nav item (intro, Korczak) clear the highlight
  // instead of leaving the previous item marked.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const sections = [...document.querySelectorAll<HTMLElement>('main > section[id]')];
  if (links.length && sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => {
            if (a.dataset.nav === e.target.id) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
          moveDot();
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }

  // The accent dot slides to the current link (transform only).
  const dot = document.querySelector<HTMLElement>('[data-nav-dot]');
  const navEl = document.querySelector<HTMLElement>('.nav-desktop');
  function moveDot() {
    if (!dot || !navEl) return;
    const current = document.querySelector<HTMLAnchorElement>('[data-nav][aria-current]');
    if (!current || !current.offsetWidth) {
      dot.classList.remove('is-on');
      return;
    }
    const r = current.getBoundingClientRect();
    const x = r.left - navEl.getBoundingClientRect().left + r.width / 2;
    dot.style.transform = `translateX(${x}px)`;
    // First appearance: jump into place, then fade in (no slide from the left edge).
    if (!dot.classList.contains('is-on')) void dot.offsetWidth;
    dot.classList.add('is-on');
  }
  addEventListener('resize', moveDot, { passive: true });

  // Project index (desktop): a small disclosure next to "Projects".
  // Opens on click; closes on Esc (focus returns to the button), on a click
  // outside, on choosing a project, or when focus leaves it.
  const indexRoot = document.querySelector<HTMLElement>('[data-index-root]');
  const indexBtn = document.querySelector<HTMLButtonElement>('[data-index-btn]');
  const indexPanel = document.querySelector<HTMLElement>('[data-index]');
  if (indexRoot && indexBtn && indexPanel) {
    let hideTimer = 0;
    const isOpen = () => indexBtn.getAttribute('aria-expanded') === 'true';
    const open = () => {
      clearTimeout(hideTimer);
      indexPanel.hidden = false;
      void indexPanel.offsetWidth; // start the transition from the closed state
      indexPanel.classList.add('is-open');
      indexBtn.setAttribute('aria-expanded', 'true');
    };
    const close = (focusButton = false) => {
      if (!isOpen()) return;
      indexPanel.classList.remove('is-open');
      indexBtn.setAttribute('aria-expanded', 'false');
      hideTimer = window.setTimeout(() => (indexPanel.hidden = true), 160);
      if (focusButton) indexBtn.focus();
    };
    indexBtn.addEventListener('click', () => (isOpen() ? close() : open()));
    indexRoot.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        e.stopPropagation();
        close(true);
      }
    });
    indexRoot.addEventListener('focusout', (e) => {
      if (!indexRoot.contains(e.relatedTarget as Node | null)) close();
    });
    document.addEventListener('click', (e) => {
      if (!indexRoot.contains(e.target as Node)) close();
    });
    indexPanel.querySelectorAll('[data-index-link]').forEach((a) => a.addEventListener('click', () => close()));
  }
</script>

<style>
  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }
  .brand {
    font-weight: 500;
    font-size: var(--step--1);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nav-desktop {
    display: none;
    position: relative;
    margin-left: auto;
  }
  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    position: relative;
    font-size: var(--step--1);
    color: var(--muted);
    padding-block: var(--space-2);
    transition: color 200ms var(--ease-out);
  }
  .nav-desktop a:hover,
  .nav-desktop a[aria-current] {
    color: var(--text);
  }

  /* Project index (desktop dropdown) */
  .has-index {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .index-btn {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }
  .index-btn svg {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 200ms var(--ease-out);
  }
  .index-btn[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .index-btn:hover,
  .index-btn[aria-expanded='true'] {
    color: var(--text);
    background: rgb(242 237 227 / 0.08);
  }
  .index {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: -1rem;
    z-index: 60;
    min-width: 15rem;
    padding: var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--board-raised);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transform-origin: 1.5rem top;
    transition:
      opacity 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  .index.is-open {
    opacity: 1;
    transform: none;
    transition-duration: 180ms;
  }
  .nav-desktop .index ol {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
  }
  .nav-desktop .index a {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    color: var(--chalk);
    white-space: nowrap;
  }
  .nav-desktop .index a:hover,
  .nav-desktop .index a:focus-visible {
    background: rgb(242 237 227 / 0.07);
  }
  .cat-dot {
    flex-shrink: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--cat-learning);
  }
  [data-cat='health'] .cat-dot {
    background: var(--cat-health);
  }
  [data-cat='community'] .cat-dot {
    background: var(--cat-community);
  }
  @media (prefers-reduced-motion: reduce) {
    .index,
    .index.is-open {
      transform: none;
    }
    .index-btn svg {
      transition: none;
    }
  }
  /* The dot under the current section: the site's data-point motif. */
  .nav-dot {
    position: absolute;
    left: -2.5px;
    bottom: -4px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 380ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }
  .nav-dot:not(.is-on) {
    transition: opacity 200ms var(--ease-out);
  }
  .nav-dot.is-on {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dot {
      transition: none;
    }
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0 var(--space-1);
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 200ms var(--ease-out);
  }
  .tool:hover {
    color: var(--text);
  }
  @media (min-width: 56rem) {
    .nav-desktop {
      display: block;
    }
    .menu-btn {
      display: none;
    }
    .tools {
      display: none;
    }
  }

  /* Full-screen mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
  }
  .menu::backdrop {
    background: var(--bg);
  }
  .menu-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    border-bottom: 1px solid var(--border);
  }
  .menu nav {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .menu-list > li {
    border-bottom: 1px solid var(--border);
  }
  .menu-list > li > a {
    display: block;
    padding-block: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
  }
  .menu-projects {
    display: grid;
    margin: calc(-1 * var(--space-2)) 0 var(--space-3);
  }
  .menu-projects a {
    display: flex;
    align-items: center;
    gap: 0.7em;
    min-height: 2.75rem;
    font-size: var(--step-0);
    color: var(--chalk);
  }
  .menu-foot {
    margin-top: auto;
    padding-block: var(--space-5);
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
