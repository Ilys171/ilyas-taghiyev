---
/**
 * Research: the working paper, and its finding drawn as 100 dots
 * (each dot = 1% of squared forecast error).
 *   filled (77)      asset-risk surprises in every portfolio and model
 *   orange ring (18) the range: 77–95% depending on portfolio and model
 *   empty (5)        correlation surprises in every case
 * Motion (src/scripts/motion.ts): the dots fill in order with scroll.
 * Facts as in the CV and the public preprint on Zenodo.
 */
import { research as r } from '../data/content';
const { low, high } = r.keyResult;
const dots = Array.from({ length: 100 }, (_, i) => (i < low ? 'asset' : i < high ? 'range' : 'corr'));
---

<section id="research" class="research" aria-labelledby="research-title">
  <div class="wrap">
    <h2 id="research-title" class="title" data-reveal>Research</h2>

    <article class="paper" aria-labelledby="paper-title">
      <div class="paper-head" data-reveal>
        <h3 id="paper-title" class="paper-title">{r.title}</h3>
        <p class="authors">
          {
            r.authors.map((a, i) => (
              <>
                {i > 0 && ', '}
                <span class:list={['author', { me: i === 0 }]}>{a}</span>
              </>
            ))
          }
        </p>
        <p class="paper-meta">{r.kicker.replace(' · ', ', ')} · Zenodo</p>
      </div>

      <div class="paper-body">
        <div class="abstract" data-reveal>
          <p class="summary">{r.summary}</p>
          <p class="mine"><span class="mine-k">My part</span> {r.myPart}</p>
          <p class="read">
            <a class="button ext" href={r.link.href} target="_blank" rel="noopener noreferrer">
              {r.link.label}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        </div>

        <figure class="finding" data-share-grid>
          <p class="result">
            <span class="result-v">{r.keyResult.value}</span>
            <span class="result-l">{r.keyResult.label}</span>
          </p>
          <div
            class="dots"
            role="img"
            aria-label={`100 dots, one per 1% of squared forecast error. ${low} filled: asset-risk surprises in every portfolio and model. ${high - low} outlined: the range from ${low}% to ${high}%, depending on portfolio and model. ${100 - high} empty: correlation surprises in every case.`}
          >
            {dots.map((kind) => <span class={`d d--${kind}`} data-dot />)}
          </div>
          <figcaption>
            <p class="range-note">{r.keyResult.rangeNote}</p>
            <ul class="legend">
              <li><i class="k k--asset"></i><span><b>{low}</b> asset-risk surprises, in every case</span></li>
              <li><i class="k k--range"></i><span><b>{high - low}</b> the range: {low}–{high}% depending on portfolio and model</span></li>
              <li><i class="k k--corr"></i><span><b>{100 - high}</b> correlation surprises, in every case</span></li>
            </ul>
            <p class="unit">Each dot is 1% of squared forecast error.</p>
          </figcaption>
        </figure>
      </div>
    </article>
  </div>
</section>

<style>
  .research {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }
  .title {
    font-size: var(--step-5);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 360;
  }

  /* The paper: the one raised panel on the site. */
  .paper {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius);
    background: var(--board-raised);
  }
  .paper-head {
    display: grid;
    gap: var(--space-3);
  }
  .paper-title {
    max-width: 30ch;
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-weight: 380;
  }
  .authors {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .author.me {
    color: var(--chalk);
    font-weight: 600;
  }
  .paper-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .paper-body {
    display: grid;
    gap: var(--space-6);
  }
  .abstract {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .summary {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.5;
    font-weight: 380;
  }
  .mine {
    max-width: 58ch;
    color: var(--muted);
  }
  .mine-k {
    margin-right: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--chalk);
  }

  /* The finding */
  .finding {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    align-content: start;
  }
  .result {
    display: grid;
    gap: var(--space-1);
  }
  .result-v {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 360;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--orange);
  }
  .result-l {
    max-width: 32ch;
  }
  .dots {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(5px, 1.4vw, 9px);
    max-width: 22rem;
  }
  .d {
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .d--asset {
    background: var(--chalk);
  }
  .d--range {
    box-shadow: inset 0 0 0 2px var(--orange);
  }
  .d--corr {
    box-shadow: inset 0 0 0 1.5px rgb(242 237 227 / 0.35);
  }
  .range-note {
    max-width: 44ch;
    font-size: var(--step--1);
    color: var(--chalk);
  }
  .legend {
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .legend li {
    display: flex;
    gap: 0.7em;
    align-items: baseline;
  }
  .legend b {
    font-weight: 600;
    color: var(--chalk);
    font-variant-numeric: tabular-nums;
  }
  .k {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    transform: translateY(0.1em);
  }
  .k--asset {
    background: var(--chalk);
  }
  .k--range {
    box-shadow: inset 0 0 0 2px var(--orange);
  }
  .k--corr {
    box-shadow: inset 0 0 0 1.5px rgb(242 237 227 / 0.45);
  }
  .unit {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .research {
      padding-block: var(--space-9);
    }
    .paper {
      padding: var(--space-7);
    }
    .paper-body {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--space-7);
    }
  }
</style>
