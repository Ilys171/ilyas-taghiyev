---
import SectionHead from './SectionHead.astro';
import { research as r } from '../data/content';
const { low, high } = r.keyResult;
---

<section id="research" class="section" aria-labelledby="research-title">
  <div class="wrap">
    <SectionHead num="02" label="Research" title="Research" id="research">
      <p>An independent preprint in financial statistics.</p>
    </SectionHead>

    <div class="grid-12">
      <article class="paper" aria-labelledby="paper-title" data-reveal>
        <p class="label kicker">{r.kicker}</p>
        <h3 id="paper-title" class="paper-title">{r.title}</h3>
        <p class="authors">
          {
            r.authors.map((a, i) => (
              <>
                {i > 0 && ', '}
                <span class="author">{a}</span>
              </>
            ))
          }
        </p>

        <div class="abstract">
          <h4 class="label">In short</h4>
          <p class="pretty">{r.summary}</p>
          <p class="mine"><span class="label">My part</span> {r.myPart}</p>
        </div>

        <div class="result">
          <p class="result-v">{r.keyResult.value}</p>
          <p class="result-l">{r.keyResult.label}</p>
        </div>

        <figure class="share" data-share>
          <div
            class="share-track"
            role="img"
            aria-label={`Bar from 0 to 100% of squared forecast error. Asset-risk surprises account for ${low}% to ${high}%; correlation surprises for the rest.`}
          >
            <span class="share-fill" style={`width:${low}%`}></span>
            <span class="share-band" style={`left:${low}%;width:${high - low}%`}></span>
          </div>
          <div class="share-scale" aria-hidden="true">
            <span style="left:0">0%</span>
            <span class="hi" style={`left:${low}%`}>{low}%</span>
            <span class="hi" style={`left:${high}%`}>{high}%</span>
          </div>
          <figcaption>
            <span class="share-note"><i class="key key-fill"></i>asset-risk surprises</span>
            <span class="share-note"><i class="key key-band"></i>the range we found, {low}–{high}%</span>
            <span class="share-note"><i class="key key-rest"></i>correlation surprises: the rest</span>
          </figcaption>
        </figure>

        <p class="pdf meta">
          <a class="link ext" href={r.link.href} target="_blank" rel="noopener noreferrer">
            {r.link.label}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .paper {
    grid-column: 1 / -1;
    background: var(--surface);
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }
  .kicker {
    margin: 0;
  }
  .paper-title {
    font-size: var(--step-4);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 30ch;
    margin: var(--space-4) auto 0;
  }
  .authors {
    margin: var(--space-4) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .author {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
    font-size: 1.12em;
    color: var(--text);
  }
  .abstract {
    max-width: 40rem;
    margin: var(--space-6) auto 0;
    text-align: left;
  }
  .abstract h4 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-weight: 400;
  }
  .abstract p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.5;
    hyphens: auto;
  }
  .result {
    max-width: 40rem;
    margin: var(--space-6) auto 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--text);
    text-align: left;
    display: grid;
    gap: var(--space-2);
  }
  .result-v {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .result-l {
    margin: 0;
    max-width: 40ch;
  }
  .abstract .mine {
    margin: var(--space-4) 0 0;
    hyphens: manual;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--muted);
    line-height: 1.55;
  }
  .mine .label {
    margin-right: 0.5em;
  }

  .share {
    max-width: 40rem;
    margin: var(--space-5) auto 0;
    text-align: left;
  }
  .share-track {
    position: relative;
    height: 14px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--border);
    overflow: hidden;
  }
  .share-fill,
  .share-band {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }
  .share-fill {
    background: var(--accent);
  }
  .share-band {
    background: repeating-linear-gradient(-45deg, var(--accent) 0 2px, transparent 2px 6px);
  }
  .share-scale {
    position: relative;
    height: 1.5em;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .share-scale span {
    position: absolute;
    top: 0;
    translate: -50% 0;
  }
  .share-scale span:first-child {
    translate: 0 0;
  }
  .share-scale .hi {
    color: var(--text);
  }
  .share-scale .hi:last-child {
    translate: -60% 0;
  }
  .share figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .share-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .key {
    display: inline-block;
    width: 10px;
    height: 10px;
  }
  .key-fill {
    background: var(--accent);
  }
  .key-band {
    background: repeating-linear-gradient(-45deg, var(--accent) 0 2px, transparent 2px 5px);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .key-rest {
    box-shadow: inset 0 0 0 1px var(--border);
    background: var(--bg);
  }
  .pdf {
    max-width: 40rem;
    margin: var(--space-5) auto 0;
    text-align: left;
    font-size: var(--step--2);
  }


  @media (min-width: 48rem) {
    .paper {
      padding: var(--space-8) var(--space-7);
    }
    .result {
      grid-template-columns: auto 1fr;
      align-items: end;
      gap: var(--space-5);
    }
  }
  @media (min-width: 64rem) {
    .paper {
      grid-column: 4 / -1;
    }
  }
</style>
