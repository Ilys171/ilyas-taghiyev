---
import DotPlot from './DotPlot.astro';
import { site } from '../data/content';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="grid-12 intro">
      <p class="meta hero-meta">
        {
          site.meta.map((m, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
              <span class="nowrap">{m}</span>
            </>
          ))
        }
      </p>
      <h1 id="hero-title">{site.name}</h1>
      <div class="statement">
        <p class="tagline">{site.tagline}</p>
        <p class="lead pretty">{site.lead}</p>
        <p class="actions">
          <a class="action" href="#projects">See projects <span aria-hidden="true">↓</span></a>
          <a class="action" href="#contact">Contact <span aria-hidden="true">↓</span></a>
        </p>
      </div>
    </div>
    <div class="figure">
      <DotPlot />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
  }
  .intro {
    row-gap: var(--space-4);
  }
  .hero-meta,
  h1,
  .statement {
    grid-column: 1 / -1;
    margin: 0;
  }
  .nowrap {
    white-space: nowrap;
  }
  @media (max-width: 47.99rem) {
    .hero-meta .nowrap {
      display: block;
    }
    .hero-meta .sep {
      display: none;
    }
  }
  h1 {
    font-size: var(--step-6);
    line-height: 0.95;
    letter-spacing: -0.025em;
    font-weight: 380;
    margin-top: var(--space-2);
  }
  .statement {
    margin-top: var(--space-4);
  }
  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .lead {
    margin: var(--space-4) 0 0;
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-5) 0 0;
  }
  .action {
    display: inline-flex;
    gap: 0.4em;
    align-items: baseline;
    padding-block: var(--space-2);
    font-weight: 500;
    border-bottom: 1px solid var(--text);
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .action span {
    font-family: var(--font-mono);
    transition: translate 200ms var(--ease-out);
  }
  .action:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .action:hover span {
    translate: 0 2px;
  }
  .figure {
    margin-top: var(--space-6);
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--space-7);
    }
    .hero-meta,
    h1 {
      grid-column: 1 / -1;
    }
    .statement {
      grid-column: 4 / span 7;
      margin-top: var(--space-5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .action span {
      transition: none;
    }
  }
</style>
