---
/**
 * Intro (first screen): what Ilyas wants to study, his name, one sentence,
 * school and location, and a quiet scroll cue. Scores live in Academics.
 * Motion (src/scripts/motion.ts): masked name reveal and staggered lines on
 * load. The HTML always holds the final state.
 */
import { site } from '../data/content';
const words = site.name.split(' ');
---

<section class="intro" id="top" aria-labelledby="hero-title">
  <div class="wrap inner">
    <div class="copy">
      <p class="study" data-intro>I want to study <em>{site.study}</em></p>
      <h1 id="hero-title" class="name">
        {
          words.map((w, i) => (
            <>
              {i > 0 && ' '}
              <span class="mask">
                <span class="mask-in" data-intro-word>
                  {w}
                </span>
              </span>
            </>
          ))
        }
      </h1>
      <p class="sentence" data-intro>{site.intro}</p>
      <p class="where" data-intro>
        <span class="school">{site.school}</span>
        <span class="place">{site.meta.join(' · ')}</span>
      </p>
    </div>

    <div class="cue-wrap" data-scroll-cue>
      <a class="cue" href="#academics" data-intro>
        <span class="cue-label">Scroll</span>
        <span class="cue-line" aria-hidden="true"><span class="cue-dot"></span></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* The intro fills the first screen; the copy sits in its lower half and the
     cue at the bottom edge. */
  .intro {
    min-height: calc(100svh - var(--header-h));
    display: flex;
  }
  .inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-4);
  }
  .copy {
    display: grid;
    gap: var(--space-4);
  }

  .study {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    font-weight: 380;
    color: var(--chalk);
  }
  .study em {
    font-style: italic;
  }

  /* Name: the largest type on the site. */
  .name {
    font-size: var(--step-6);
    line-height: 0.95;
    letter-spacing: -0.025em;
    font-weight: 360;
    font-variation-settings: 'opsz' 144;
  }
  /* Each word sits in a mask so it can rise into view (transform only).
     Padding keeps descenders (y, g) inside the mask. */
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .mask-in {
    display: inline-block;
  }

  .sentence {
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .where {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--muted);
  }
  .school {
    color: var(--chalk);
  }

  /* Scroll cue: a small label and a thin chalk line with one dot travelling
     down it. Quiet; static with reduced motion. */
  .cue-wrap {
    align-self: flex-start;
  }
  .cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 200ms var(--ease-out);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: var(--border-strong);
  }
  .cue-dot {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--chalk);
  }
  @media (hover: hover) {
    .cue:hover {
      color: var(--chalk);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cue-dot {
      animation: cue 2.4s var(--ease-in-out) 1.6s infinite;
    }
  }
  @keyframes cue {
    0% {
      transform: translateY(-6px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translateY(2.9rem);
      opacity: 0;
    }
  }

  @media (min-width: 64rem) {
    .inner {
      padding-bottom: var(--space-5);
    }
    .copy {
      gap: var(--space-5);
    }
    .sentence {
      max-width: 34ch;
    }
  }

  /* Starting state for the load animation: only while JS runs and motion
     is allowed. Without JS, or with reduced motion, everything is visible. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.no-motion)) .mask-in {
      transform: translateY(105%);
    }
    :global(.js:not(.no-motion)) [data-intro] {
      opacity: 0;
    }
  }
</style>
