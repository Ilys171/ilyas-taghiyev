---
/**
 * A photo slot. Renders an optimized <picture> when
 * src/assets/photos/<id>.(jpg|jpeg|png|webp) exists; otherwise a labelled
 * placeholder in dev and nothing at all in production.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { photos } from '../data/photos';

interface Props {
  id: string;
  /** `sizes` attribute for the responsive image. */
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { id, sizes = '(min-width: 64rem) 66vw, 100vw', eager = false, class: cls } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === id);
const slot = photos[id];
if (!slot) throw new Error(`Unknown photo slot: ${id}`);
const dev = import.meta.env.DEV;
---

{
  match ? (
    <figure class:list={['photo', cls]}>
      <Picture
        src={match[1].default}
        alt={slot.alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600].filter((w) => w <= match[1].default.width)}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {slot.caption && <figcaption class="meta">{slot.caption}</figcaption>}
    </figure>
  ) : (
    dev && (
      <figure class:list={['photo', 'photo--empty', cls]} style={`aspect-ratio:${slot.ratio}`}>
        <span class="label">
          Photo · {slot.priority} · src/assets/photos/{id}.jpg
        </span>
        <span class="shows">{slot.shows}</span>
      </figure>
    )
  )
}

<style>
  .photo {
    margin: 0;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--2);
  }
  .photo--empty {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px dashed var(--muted);
    color: var(--muted);
    background: repeating-linear-gradient(-45deg, transparent 0 10px, var(--surface) 10px 11px);
  }
  .shows {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    max-width: 48ch;
    line-height: 1.45;
  }
</style>
