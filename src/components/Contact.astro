---
/** Contact: a heading in Ilyas's voice, the email, LinkedIn. */
import { site } from '../data/content';
import Mark from './Mark.astro';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <Mark kind="bell" class="mark-tr mark-wide-only" />
  <div class="wrap inner">
    <h2 id="contact-title" class="title" data-heading>Every child counts. <span class="soft">Write to me.</span></h2>
    <p class="email" data-reveal>
      <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="other" data-reveal>
      <a class="button ext" href={site.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </p>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-8) var(--space-9);
    border-top: 1px solid var(--border);
  }
  .inner {
    display: grid;
    gap: var(--space-5);
  }
  .title {
    max-width: 14ch;
    font-size: var(--step-6);
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-weight: 360;
    font-variation-settings: 'opsz' 144;
  }
  .soft {
    font-style: italic;
    color: var(--muted);
  }
  .email {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .email-link {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .email-link:hover {
      text-decoration-color: var(--orange);
    }
  }
</style>
