---
/** About: short. The facts about Ilyas are in the intro; this only says why statistics. */
import SectionHead from './SectionHead.astro';
import { about } from '../data/content';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead num="04" label="About" title="About" id="about" />

    <div class="grid-12">
      <div class="text" data-reveal>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .text {
    grid-column: 1 / -1;
  }
  .text p {
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.3;
    font-weight: 360;
  }
  @media (min-width: 64rem) {
    .text {
      grid-column: 4 / -1;
    }
  }
</style>
