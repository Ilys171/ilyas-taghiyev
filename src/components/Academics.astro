---
/**
 * Academics: exam scores (main element) and academic honors from the CV.
 * Scores are exactly as supplied by Ilyas; never recalculated.
 * Motion (src/scripts/motion.ts): main numbers count up once when the
 * section enters the viewport. The HTML always holds the final values.
 */
import { scores, academicHonors } from '../data/content';
import Mark from './Mark.astro';
const decimals = (v: string) => (v.includes('.') ? v.split('.')[1].length : 0);
---

<section id="academics" class="academics" aria-labelledby="academics-title">
  <div class="wrap">
    <Mark kind="tally" class="mark-tr" />
    <h2 id="academics-title" class="title" data-heading>Academics</h2>

    <ul class="score-list" aria-label="Exam scores">
      {
        scores.map((s) => (
          <li class="score" data-reveal>
            <div class="score-head">
              <h3 class="score-test">{s.test}</h3>
              <time class="score-date" datetime={s.datetime}>
                {s.date}
              </time>
            </div>
            <p class="score-value">
              <span aria-hidden="true">
                <span
                  data-countup-view={s.value}
                  data-decimals={decimals(s.value)}
                  style={`min-width:${s.value.length}ch`}
                >
                  {s.value}
                </span>
              </span>
              <span class="sr-only">{`${s.test}: ${s.value}`}</span>
            </p>
            <dl class="parts">
              {s.parts.map((p) => (
                <div>
                  <dt>{p.label}</dt>
                  <dd>{p.value}</dd>
                </div>
              ))}
            </dl>
            {s.note && <p class="score-note">{s.note}</p>}
          </li>
        ))
      }
    </ul>

    <div class="honors" data-reveal>
      <h3 class="honors-title">Honors</h3>
      <ul class="honor-list">
        {
          academicHonors.map((h) => (
            <li class="honor">
              <p class="honor-name">{h.title}</p>
              <p class="honor-meta">{h.meta}</p>
              <p class="honor-note">{h.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .academics {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }
  .title {
    font-size: var(--step-5);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 360;
  }

  /* Scores: an open, ruled table of three columns, not boxed cards.
     Phone: stacked, each test separated by a strong rule. */
  .score-list {
    display: grid;
    margin-top: var(--space-6);
  }
  .score {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-strong);
  }
  .score-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .score-test {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }
  .score-date {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }
  .score-value {
    font-family: var(--font-display);
    font-size: var(--step-6);
    font-weight: 340;
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
    font-variation-settings: 'opsz' 144;
  }
  .score-value [data-countup-view] {
    display: inline-block;
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .parts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: var(--space-2);
    border-top: 1px solid var(--border);
  }
  .parts dt {
    color: var(--muted);
  }
  .parts dd {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .score-note {
    max-width: 42ch;
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--muted);
  }

  /* Honors: a clean list under the scores */
  .honors {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .honors-title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
  }
  .honor {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .honor-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    text-wrap: balance;
  }
  .honor-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .honor-note {
    max-width: 60ch;
    margin-top: var(--space-1);
    color: var(--chalk);
  }

  @media (min-width: 56rem) {
    .academics {
      padding-block: var(--space-9);
    }
    .score-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--border-strong);
    }
    .score {
      border-top: 0;
      padding: var(--space-5) var(--space-5) var(--space-4);
      border-left: 1px solid var(--border);
    }
    .score:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .score:last-child {
      padding-right: 0;
    }
    .parts {
      grid-template-columns: 1fr;
    }
    .parts div {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3);
    }
    .parts dd {
      font-size: var(--step-0);
      flex-shrink: 0;
    }
    .honors {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-4);
      margin-top: var(--space-8);
    }
    .honors-title {
      grid-column: 1 / span 3;
      padding-top: var(--space-4);
    }
    .honor-list {
      grid-column: 4 / -1;
    }
  }
</style>
