---
/**
 * Recognition: honors and selections, then public media coverage.
 * Not a timeline (no dates): each item is tagged with the project it belongs
 * to, in that project's category colour. No logos, nothing from letters.
 */
import { honors, media, projects } from '../data/content';
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
---

<section id="recognition" class="recognition" aria-labelledby="recognition-title">
  <div class="wrap">
    <h2 id="recognition-title" class="title" data-reveal>Recognition</h2>

    <div class="cols">
      <div class="block" data-reveal>
        <h3 class="block-title">Honors and selections</h3>
        <ul class="honors">
          {
            honors.map((h) => {
              const p = bySlug[h.project];
              return (
                <li data-cat={p.category}>
                  <p class="honor">{h.title}</p>
                  <a class="tag" href={`#${p.slug}`}>
                    <span class="tag-dot" aria-hidden="true" />
                    {p.title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="block" data-reveal>
        <h3 class="block-title">In the media</h3>
        <ul class="media">
          {
            media.map((m) => {
              const p = bySlug[m.project];
              return (
                <li data-cat={p.category}>
                  <a class="clip" href={m.href} target="_blank" rel="noopener noreferrer">
                    <span class="outlet">{m.outlet}</span>
                    <span class="what">{m.text}</span>
                    <span class="go ext" aria-hidden="true">Read</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .recognition {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }
  .title {
    font-size: var(--step-5);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 360;
  }
  .cols {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-6);
  }
  .block {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .block-title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
  }

  [data-cat] {
    --cat: var(--cat-learning);
  }
  [data-cat='health'] {
    --cat: var(--cat-health);
  }
  [data-cat='community'] {
    --cat: var(--cat-community);
  }

  /* Honors: statements, each with its project tag */
  .honors {
    display: grid;
  }
  .honors li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .honors li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .honor {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    font-weight: 380;
    text-wrap: balance;
  }
  .tag {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    transition: color 200ms var(--ease-out);
  }
  .tag-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--cat);
  }
  @media (hover: hover) and (pointer: fine) {
    .tag:hover {
      color: var(--chalk);
    }
  }

  /* Media: link cards, two per row on wide screens */
  .media {
    display: grid;
    gap: var(--space-3);
  }
  .clip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'outlet go'
      'what go';
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    transition:
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .clip:active {
    transform: scale(0.985);
  }
  .outlet {
    grid-area: outlet;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .what {
    grid-area: what;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .go {
    grid-area: go;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--chalk);
  }
  @media (hover: hover) and (pointer: fine) {
    .clip:hover {
      border-color: var(--cat);
      background: rgb(242 237 227 / 0.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clip:active {
      transform: none;
    }
  }

  @media (min-width: 64rem) {
    .recognition {
      padding-block: var(--space-9);
    }
    .cols {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--space-7);
    }
  }
</style>
